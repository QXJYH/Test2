&#9;&#9;h.AttachmentPos = Vector3.new(0, 0.9, 0)
                h.AttachmentRight = Vector3.new(1, 0, 0)
                h.AttachmentUp = Vector3.new(0, 0.995, -0.0995)
&#9;&#9;wait(5)
&#9;&#9;debounce = true
&#9;end
end

