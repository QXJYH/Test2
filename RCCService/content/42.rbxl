&#9;&#9;h.AttachmentPos = Vector3.new(0.12, 0.3, -0.07)
&#9;&#9;h.AttachmentRight = Vector3.new(0.981, 0, 0.196)
&#9;&#9;h.AttachmentUp = Vector3.new(0, 1, -0)
&#9;&#9;wait(1)
&#9;&#9;debounce = true
&#9;end
end

