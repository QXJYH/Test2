					<Item class="Script" referent="RBX4786">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local armor = script.Parent.Armor
local button = script.Parent.Button

function unAnchor(obj)
&#9;if obj.className == &quot;Part&quot; or obj.className == &quot;Seat&quot; then
&#9;&#9;obj.Anchored = false
&#9;elseif obj.className == &quot;Model&quot; then
&#9;&#9;local child = obj:getChildren()
&#9;&#9;for i=1, #child do
&#9;&#9;&#9;if child[i].className == &quot;Part&quot; or child[i].className == &quot;Seat&quot; then
&#9;&#9;&#9;&#9;child[i].Anchored = false
&#9;&#9;&#9;elseif child[i].className == &quot;Model&quot; then
&#9;&#9;&#9;&#9;unAnchor(child[i])
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function debug(model)
&#9;local C = model:getChildren()
&#9;for i=1, #C do
&#9;&#9;if C[i].className == &quot;Part&quot; then
&#9;&#9;&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;&#9;&#9;weld.Part0 = model.Part
&#9;&#9;&#9;weld.Part1 = C[i]
&#9;&#9;&#9;local Cref = CFrame.new(model.Part.Position)
&#9;&#9;&#9;local C0 = model.Part.CFrame:inverse()*Cref
&#9;&#9;&#9;local C1 = C[i].CFrame:inverse()*Cref
&#9;&#9;&#9;weld.C0 = C0
&#9;&#9;&#9;weld.C1 = C1
&#9;&#9;&#9;weld.Parent = weld.Part1
&#9;&#9;end
&#9;end
end

function linkArmor(obj, weldedTo)
&#9;local weld = Instance.new(&quot;Weld&quot;)
&#9;weld.Part0 = weldedTo
&#9;weld.Part1 = obj
&#9;weld.C1 = CFrame.new(0,0,0)
&#9;weld.Parent = weldedTo
&#9;weld.Name = &quot;ArmorWeld&quot;
end

function removeHat(char)
&#9;local get = char:getChildren()
&#9;for i=1, #get do
&#9;&#9;if get[i].className == &quot;Hat&quot; then
&#9;&#9;&#9;get[i]:remove()
&#9;&#9;elseif get[i]:findFirstChild(&quot;Handle&quot;) and get[i].className ~= &quot;Tool&quot; then
&#9;&#9;&#9;get[i]:remove()
&#9;&#9;end
&#9;end
end

function onTouch(hit)
&#9;local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil  and hit.Parent:findFirstChild(&quot;HasSuperArmor&quot;) == nil then
&#9;&#9;local char = hit.Parent
&#9;&#9;removeHat(char)
&#9;&#9;local child = armor:getChildren()
&#9;&#9;for z=1, #child do
&#9;&#9;&#9;local getPart = char:findFirstChild(child[z].Name)
&#9;&#9;&#9;if getPart ~= nil then
&#9;&#9;&#9;&#9;if child[z]:findFirstChild(&quot;Part&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;local armorPart = child[z]:clone()
&#9;&#9;&#9;&#9;&#9;armorPart:makeJoints()
&#9;&#9;&#9;&#9;&#9;unAnchor(armorPart)
&#9;&#9;&#9;&#9;&#9;debug(armorPart)
&#9;&#9;&#9;&#9;&#9;armorPart.Parent = char
&#9;&#9;&#9;&#9;&#9;armorPart.Name = &quot;Armor&quot;..armorPart.Name..&quot;&quot;
&#9;&#9;&#9;&#9;&#9;linkArmor(armorPart.Part, getPart)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;&#9;local db = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;db.Parent = char
&#9;&#9;db.Name = &quot;HasSuperArmor&quot;
&#9;&#9;local torso = char:findFirstChild(&quot;Torso&quot;)
&#9;&#9;if torso ~= nil then
&#9;&#9;&#9;torso.CFrame = button.CFrame + Vector3.new(0, 5, 0)
&#9;&#9;end
&#9;end
end

button.Touched:connect(onTouch)
-- Malvaviscos
--I made this armor.
--This armor was made by Malvaviscos.
--Give me credit if you upload another version.</ProtectedString>
