					<Item class="Script" referent="RBX290">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">--- SonOfSevenless
print(&quot;Teleport Spell Loaded&quot;)

local COOLDOWN = 0
local MP = 0



bin = script.Parent

function TryToCast(player)
&#9;-- returns true if player may cast this spell

&#9;-- make sure this player has the wizard board stats
&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)
&#9;if stats == nil then return false end
&#9;local mana = stats:findFirstChild(&quot;Mana&quot;)
&#9;local level = stats:findFirstChild(&quot;Level&quot;)
&#9;if mana == nil or level == nil then return false end

&#9;if (mana.Value &gt;= MP) then
&#9;&#9;mana.Value = mana.Value - MP
&#9;&#9;return true
&#9;end

&#9;return false
end

function animation()

&#9;local f = Instance.new(&quot;ForceField&quot;)
&#9;part = Instance.new(&quot;Part&quot;)
&#9;f.Parent = part
&#9;char = game.Players.LocalPlayer.Character
&#9;part.Parent = char
&#9;part.CanCollide = false
&#9;part.Anchored = true
&#9;part.Size = Vector3.new(1,1,1)
&#9;part.BrickColor = BrickColor.Black()
&#9;part.Transparency = .8
&#9;part.formFactor = 0
&#9;part.Name = &quot;Box&quot;
&#9;part.TopSurface = 0
&#9;part.BottomSurface = 0
&#9;part.CFrame = char.Torso.CFrame

&#9;grow()

end

function grow(pos)

&#9;while part.Size.y &lt; 10 do
&#9;&#9;wait(.02)
&#9;&#9;part.Size = Vector3.new(part.Size.x+1, part.Size.y+1, part.Size.z+1)
&#9;&#9;part.CFrame = char.Torso.CFrame
&#9;end

&#9;shrink(pos)

end

function grow2()

&#9;while part.Size.y &lt; 10 do

&#9;&#9;wait(.02)
&#9;&#9;part.Size = Vector3.new(part.Size.x+1, part.Size.y+1, part.Size.z+1)
&#9;&#9;part.CFrame = char.Torso.CFrame
&#9;end

&#9;shrink2()

end

function shrink(pos)

&#9;local p = char:GetChildren()

&#9;while part.Size.y &gt; 1 do
&#9;&#9;wait(.02)
&#9;&#9;part.Size = Vector3.new(part.Size.x-1, part.Size.y-1, part.Size.z-1)
&#9;&#9;part.CFrame = char.Torso.CFrame
&#9;end

&#9;for i=1,#p do

&#9;&#9;if p[i].className == &quot;Part&quot; then

&#9;&#9;&#9;&#9;p[i].Transparency = 1

&#9;&#9;end

&#9;&#9;if p[i].Name == &quot;Box&quot; then

&#9;&#9;&#9;p[i].Transparency = .8

&#9;&#9;end

&#9;end

&#9;local b = part:clone()
&#9;b.Parent = char
&#9;b.Shape = &quot;Ball&quot;
&#9;b.ForceField:remove()
&#9;b.Transparency = .8
&#9;b.Size = Vector3.new(1,1,1)
&#9;b.CFrame = char.Torso.CFrame

&#9;while b.Size.y &lt; 10 do
&#9;&#9;wait(.04)
&#9;&#9;b.Size = Vector3.new(b.Size.x+1, b.Size.y+1, b.Size.z+1)
&#9;&#9;b.CFrame = char.Torso.CFrame
&#9;end

&#9;b:remove()

&#9;for i=1,#p do
&#9;&#9;if p[i].className == &quot;Part&quot; then
&#9;&#9;&#9;p[i].Anchored = false
&#9;&#9;end
&#9;&#9;if p[i].Name == &quot;Box&quot; then
&#9;&#9;&#9;p[i].Anchored = true
&#9;&#9;end
&#9;end

&#9;char.Torso.CFrame = CFrame.new(Vector3.new(cf.p.x, cf.p.y + 7, cf.p.z))
&#9;
&#9;for i=1,#p do
&#9;&#9;if p[i].className == &quot;Part&quot; then
&#9;&#9;&#9;p[i].Anchored = true
&#9;&#9;end
&#9;end

&#9;grow2()

end

function shrink2()

&#9;local p = char:GetChildren()

&#9;while part.Size.y &gt; 1 do

&#9;&#9;wait(.02)
&#9;&#9;part.Size = Vector3.new(part.Size.x-1, part.Size.y-1, part.Size.z-1)
&#9;&#9;part.CFrame = char.Torso.CFrame

&#9;end



&#9;for i=1,#p do

&#9;&#9;if p[i].className == &quot;Part&quot; then

&#9;&#9;&#9;p[i].Transparency = 0

&#9;&#9;end

&#9;&#9;if p[i].Name == &quot;Box&quot; then

&#9;&#9;&#9;p[i].Transparency = .8

&#9;&#9;end

&#9;end

&#9;local b = part:clone()
&#9;b.Parent = char
&#9;b.Shape = &quot;Ball&quot;
&#9;b.ForceField:remove()
&#9;b.Transparency = .8
&#9;b.Size = Vector3.new(1,1,1)
&#9;b.CFrame = char.Torso.CFrame
&#9;part:remove()

&#9;while b.Size.y &lt; 10 do
&#9;&#9;wait(.04)
&#9;&#9;b.Size = Vector3.new(b.Size.x+1, b.Size.y+1, b.Size.z+1)
&#9;&#9;b.CFrame = char.Torso.CFrame
&#9;end

&#9;for i=1,#p do

&#9;&#9;if p[i].className == &quot;Part&quot; then

&#9;&#9;&#9;p[i].Anchored = false

&#9;&#9;end

&#9;&#9;if p[i].Name == &quot;Box&quot; then

&#9;&#9;&#9;p[i].Anchored = true

&#9;&#9;end

&#9;end

&#9;b:remove()
&#9;wait(COOLDOWN)
&#9;enabled = true

end

function teleportPlayer(pos)

&#9;local player = game.Players.LocalPlayer
&#9;if player == nil or player.Character == nil then return end

&#9;local char = player.Character

&#9;sound = Instance.new(&quot;Sound&quot;)
&#9;sound.SoundId = &quot;&quot;
&#9;sound.Parent = char
&#9;sound.PlayOnRemove = true
&#9;sound:remove()

&#9;local p = game.Players.LocalPlayer.Character:GetChildren()

&#9;for i=1,#p do

&#9;&#9;if p[i].className == &quot;Part&quot; then

&#9;&#9;&#9;p[i].Anchored = true

&#9;&#9;end

&#9;end

&#9;animation(pos)

end


enabled = true
function onButton1Down(mouse)
&#9;if not enabled then
&#9;&#9;return
&#9;end

&#9;local player = game.Players.LocalPlayer
&#9;if player == nil then return end
&#9;--if TryToCast(player) == false then return end
&#9;

&#9;enabled = false
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

&#9;-- find the best cf
&#9;cf = mouse.Hit
&#9;local v = cf.lookVector

&#9;teleportPlayer(cf.p)

&#9;wait(COOLDOWN)
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;enabled = true

end

function onSelected(mouse)
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)


</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX291">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">PUT THIS IN THE WEAPON</string>
							<ProtectedString name="Source">local debounce = false

function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

function onTouch(part) 

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil) and debounce == false then

debounce = true

local player = getPlayer(human) 

if (player == nil) then return end 

script.Parent:clone().Parent = player.Backpack

wait(2)
debounce = false
end
end


script.Parent.Parent.Touched:connect(onTouch) 
</ProtectedString>
