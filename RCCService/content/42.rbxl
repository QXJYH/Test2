								<ProtectedString name="Source">debounce = true

function onTouched(hit)
&#9;if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil and debounce == true) then
&#9;&#9;debounce = false
&#9;&#9;h = Instance.new(&quot;Hat&quot;)
&#9;&#9;p = Instance.new(&quot;Part&quot;)
&#9;&#9;h.Name = &quot;GoldenHair&quot;
